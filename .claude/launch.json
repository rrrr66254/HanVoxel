{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Vite)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["./node_modules/vite/bin/vite.js"],
      "port": 5173,
      "cwd": "packages/frontend"
    },
    {
      "name": "API Gateway (Express)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "./src/server.ts"],
      "port": 3001,
      "cwd": "packages/api-gateway"
    },
    {
      "name": "ML Service (FastAPI)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload"],
      "port": 8000,
      "autoPort": false,
      "cwd": "packages/ml-service"
    }
  ]
}
