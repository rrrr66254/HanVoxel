// HanVoxel — Phase 1 Step 1
// Spatial Digital Twin Factory Platform
// 핵심 공간 객체 + 조직/인증 테이블

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

// ============================================================
// Organization / Access — 조직 및 권한
// ============================================================

/// 회사 (최상위 테넌트)
model Company {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String   @db.VarChar(200)
  code      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")

  // --- SaaS 과금 ---
  /// 현재 플랜 (STARTER, GROWTH, ENTERPRISE)
  planType     String    @default("STARTER") @map("plan_type") @db.VarChar(20)
  /// 트라이얼 종료일
  trialEndsAt  DateTime? @map("trial_ends_at") @db.Timestamptz
  /// Stripe 고객 ID
  stripeCustomerId String? @map("stripe_customer_id") @db.VarChar(100)
  /// Stripe 구독 ID
  stripeSubscriptionId String? @map("stripe_subscription_id") @db.VarChar(100)
  /// 구독 상태 (trialing, active, past_due, canceled, unpaid)
  subscriptionStatus String @default("trialing") @map("subscription_status") @db.VarChar(30)
  /// 결제 주기 (monthly, yearly)
  billingInterval String @default("monthly") @map("billing_interval") @db.VarChar(10)
  /// 현재 결제 기간 종료일
  currentPeriodEnd DateTime? @map("current_period_end") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sites    Site[]
  users    User[]
  payments PaymentHistory[]
  partners Partner[]
  erpConnectors ErpConnectorConfig[]

  @@map("companies")
}

/// SaaS 요금제
model Plan {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 플랜 코드 (STARTER, GROWTH, ENTERPRISE)
  code         String  @unique @db.VarChar(20)
  name         String  @db.VarChar(100)
  description  String? @db.Text
  /// 월 가격 (원)
  priceMonthly Int     @default(0) @map("price_monthly")
  /// 연 가격 (원)
  priceYearly  Int     @default(0) @map("price_yearly")
  /// Stripe Price ID (월)
  stripePriceMonthly String? @map("stripe_price_monthly") @db.VarChar(100)
  /// Stripe Price ID (연)
  stripePriceYearly  String? @map("stripe_price_yearly") @db.VarChar(100)

  // --- 플랜 제한 ---
  /// 최대 사이트 수
  maxSites     Int @default(1) @map("max_sites")
  /// 최대 사용자 수
  maxUsers     Int @default(3) @map("max_users")
  /// 최대 공간 객체 수
  maxObjects   Int @default(500) @map("max_objects")
  /// 트라이얼 기간 (일)
  trialDays    Int @default(14) @map("trial_days")

  /// 기능 플래그 (JSON)
  features     Json? @db.JsonB

  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("plans")
}

/// 결제 내역
model PaymentHistory {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  /// Stripe Invoice ID
  stripeInvoiceId String? @unique @map("stripe_invoice_id") @db.VarChar(100)
  /// Stripe Payment Intent ID
  stripePaymentIntentId String? @map("stripe_payment_intent_id") @db.VarChar(100)
  /// 결제 금액 (원)
  amount         Int
  /// 통화 (krw)
  currency       String   @default("krw") @db.VarChar(10)
  /// 상태 (paid, failed, refunded, pending)
  status         String   @db.VarChar(20)
  /// 플랜 코드
  planCode       String   @map("plan_code") @db.VarChar(20)
  /// 결제 주기
  billingInterval String  @map("billing_interval") @db.VarChar(10)
  /// 결제 기간 시작
  periodStart    DateTime @map("period_start") @db.Timestamptz
  /// 결제 기간 종료
  periodEnd      DateTime @map("period_end") @db.Timestamptz
  /// 설명
  description    String?  @db.Text

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  company        Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("payment_history")
}

/// 사이트 (공장/창고 단위)
model Site {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(200)
  code      String   @db.VarChar(50)
  address   String?  @db.Text
  latitude  Float?
  longitude Float?
  timezone  String   @default("Asia/Seoul") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company        Company         @relation(fields: [companyId], references: [id])
  spatialObjects SpatialObject[]
  alerts         Alert[]
  inspections    QcInspection[]
  pickingOrders  PickingOrder[]

  @@unique([companyId, code])
  @@map("sites")
}

/// 사용자
model User {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company   Company    @relation(fields: [companyId], references: [id])
  userRoles UserRole[]

  @@map("users")
}

/// 역할
model Role {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

/// 권한
model Permission {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

/// 역할-권한 매핑
model RolePermission {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// 사용자-역할 매핑
model UserRole {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// Spatial Core — 공간 객체
// ============================================================

/// 공간 객체 타입 (SITE, BUILDING, FLOOR, ZONE, AISLE, RACK, BIN 등)
model SpatialObjectType {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String?  @db.Text
  /// 계층 깊이 (SITE=0, BUILDING=1, FLOOR=2, ...)
  depth       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  spatialObjects SpatialObject[]

  @@map("spatial_object_types")
}

/// 공간 객체 — 모든 물리적 공간 엔티티의 기본 테이블
model SpatialObject {
  id       String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId   String  @map("site_id") @db.Uuid
  typeId   String  @map("type_id") @db.Uuid
  name     String  @db.VarChar(200)
  code     String  @db.VarChar(100)
  /// 상태: ACTIVE, INACTIVE, MAINTENANCE
  status   String  @default("ACTIVE") @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")

  // --- 위치 (미터 단위, site 원점 기준) ---
  positionX Float @default(0) @map("position_x")
  positionY Float @default(0) @map("position_y")
  positionZ Float @default(0) @map("position_z")

  // --- 회전 (Euler, 라디안) ---
  rotationX Float @default(0) @map("rotation_x")
  rotationY Float @default(0) @map("rotation_y")
  rotationZ Float @default(0) @map("rotation_z")

  // --- 크기 (미터) ---
  scaleX Float @default(1) @map("scale_x")
  scaleY Float @default(1) @map("scale_y")
  scaleZ Float @default(1) @map("scale_z")

  // --- 3D 렌더링 속성 ---
  color    String? @db.VarChar(7)
  opacity  Float   @default(1.0)
  visible  Boolean @default(true)
  meshType String? @map("mesh_type") @db.VarChar(50)

  // --- 메타데이터 ---
  metadata Json? @db.JsonB

  // --- 소프트 삭제 ---
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  site Site              @relation(fields: [siteId], references: [id])
  type SpatialObjectType @relation(fields: [typeId], references: [id])

  // 계층 관계 (자기 참조)
  parentLinks SpatialHierarchy[] @relation("ChildObject")
  childLinks  SpatialHierarchy[] @relation("ParentObject")

  @@unique([siteId, code])
  @@index([siteId, typeId])
  @@index([status])
  @@map("spatial_objects")
}

// ============================================================
// Spatial Presets — 표준 규격 프리셋
// ============================================================

/// 프리셋 카테고리 (RACK, PALLET, CONTAINER, AISLE, PRODUCT_BOX, LOADED_PALLET)
model PresetCategory {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  presets SpatialPreset[]

  @@map("preset_categories")
}

/// 공간 프리셋 — warehouse-standards.md 기반 표준 규격
model SpatialPreset {
  id         String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  /// 프리셋 코드 (예: KR_STANDARD, T11, DRY_40FT)
  code       String @unique @db.VarChar(50)
  name       String @db.VarChar(200)
  /// 표준 출처 (예: KS A 1003, ISO 6780, EN 15512)
  standard   String? @db.VarChar(100)
  /// 지역 (KR, EU, US, AU, INTL)
  region     String? @db.VarChar(10)

  // --- 치수 (미터 단위) ---
  width  Float @default(0)
  depth  Float @default(0)
  height Float @default(0)

  // --- 랙/컨테이너 내부 치수 ---
  innerWidth  Float? @map("inner_width")
  innerDepth  Float? @map("inner_depth")
  innerHeight Float? @map("inner_height")

  // --- 하중/용량 ---
  /// 자중 (kg)
  weight      Float? @default(0)
  /// 최대 적재 하중 (kg)
  maxLoad     Float? @map("max_load")
  /// 용량 (CBM, 팔레트 수 등)
  capacity    Float?
  /// 단수 (랙 레벨 수)
  levels      Int?
  /// 단간 높이 (m)
  levelHeight Float? @map("level_height")
  /// 단당 하중 (kg)
  loadPerLevel Float? @map("load_per_level")

  // --- 제품 적재 정보 ---
  /// 팔레트당 수량 (박스 기준)
  qtyPerPallet Int?   @map("qty_per_pallet")
  /// 팔레트당 중량 (kg)
  kgPerPallet  Float? @map("kg_per_pallet")

  // --- 3D 렌더링 기본값 ---
  color    String? @db.VarChar(7)
  opacity  Float   @default(1.0)
  meshType String? @map("mesh_type") @db.VarChar(50)

  // --- 확장 데이터 ---
  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category           PresetCategory      @relation(fields: [categoryId], references: [id])
  rackTemplates      WarehouseTemplate[] @relation("RackPreset")
  palletTemplates    WarehouseTemplate[] @relation("PalletPreset")

  @@index([categoryId])
  @@index([region])
  @@map("spatial_presets")
}

/// 창고 템플릿 — 프리셋 조합으로 구성된 창고 유형
model WarehouseTemplate {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String @db.VarChar(200)
  code        String @unique @db.VarChar(50)
  description String? @db.Text
  /// 업종 (FOOD_BEVERAGE, AUTO_PARTS, ELECTRONICS 등)
  industry    String @db.VarChar(50)
  /// 추천 창고 크기 (m²)
  areaMin     Float? @map("area_min")
  areaMax     Float? @map("area_max")

  // --- 사용 프리셋 참조 ---
  rackPresetId      String  @map("rack_preset_id") @db.Uuid
  palletPresetId    String  @map("pallet_preset_id") @db.Uuid
  containerPresetId String? @map("container_preset_id") @db.Uuid

  // --- 레이아웃 기본값 ---
  /// 랙 배치 방식 (BACK_TO_BACK, SINGLE, DRIVE_IN)
  rackLayout     String @default("BACK_TO_BACK") @map("rack_layout") @db.VarChar(30)
  /// 통로 타입 (REACH_TRUCK, COUNTERBALANCE_3T, AGV_FORKLIFT)
  aisleType      String @default("REACH_TRUCK") @map("aisle_type") @db.VarChar(30)
  /// 통로 너비 (m)
  aisleWidth     Float  @default(2.8) @map("aisle_width")
  /// 주 통로 너비 (m)
  mainAisleWidth Float  @default(4.0) @map("main_aisle_width")

  // --- 확장 데이터 ---
  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rackPreset      SpatialPreset @relation("RackPreset", fields: [rackPresetId], references: [id])
  palletPreset    SpatialPreset @relation("PalletPreset", fields: [palletPresetId], references: [id])

  @@index([industry])
  @@map("warehouse_templates")
}

// ============================================================
// SLA — 서비스 수준 계약 모니터링
// ============================================================

/// 고객사별 SLA 기준 설정
model SlaTarget {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  siteId    String @map("site_id") @db.Uuid
  /// SLA 이름 (예: "2026 Q1 SLA")
  name      String @db.VarChar(200)

  // --- 목표 지표 ---
  /// 납기 준수율 목표 (%, 예: 98.5)
  deliveryOnTimeTarget  Float @default(98.0) @map("delivery_on_time_target")
  /// 오배송률 한도 (%, 예: 0.5 — 낮을수록 좋음)
  misshipmentRateLimit  Float @default(0.5) @map("misshipment_rate_limit")
  /// 피킹 정확도 목표 (%, 예: 99.5)
  pickingAccuracyTarget Float @default(99.5) @map("picking_accuracy_target")
  /// 평균 처리 시간 한도 (분, 예: 120)
  avgProcessingTimeLimit Float @default(120) @map("avg_processing_time_limit")

  // --- 에스컬레이션 설정 ---
  /// 에스컬레이션 활성화
  escalationEnabled Boolean @default(true) @map("escalation_enabled")
  /// 위반 시 알림 수신 이메일 (JSON 배열)
  escalationEmails  Json?   @map("escalation_emails") @db.JsonB
  /// 연속 위반 횟수 임계값 (이 횟수 이상 연속 위반 시 에스컬레이션)
  escalationThreshold Int @default(3) @map("escalation_threshold")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  metrics    SlaMetric[]
  violations SlaViolation[]

  @@unique([companyId, siteId])
  @@index([companyId])
  @@map("sla_targets")
}

/// SLA KPI 스냅샷 (일별 기록)
model SlaMetric {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slaTargetId String   @map("sla_target_id") @db.Uuid
  /// 측정 날짜
  recordDate  DateTime @map("record_date") @db.Date

  // --- 실측 KPI ---
  /// 납기 준수율 (%)
  deliveryOnTimeRate  Float @map("delivery_on_time_rate")
  /// 오배송률 (%)
  misshipmentRate     Float @map("misshipment_rate")
  /// 피킹 정확도 (%)
  pickingAccuracy     Float @map("picking_accuracy")
  /// 평균 처리 시간 (분)
  avgProcessingTime   Float @map("avg_processing_time")

  // --- 건수 ---
  /// 총 주문 건수
  totalOrders         Int   @default(0) @map("total_orders")
  /// 정시 배송 건수
  onTimeOrders        Int   @default(0) @map("on_time_orders")
  /// 오배송 건수
  misshipmentCount    Int   @default(0) @map("misshipment_count")
  /// 총 피킹 건수
  totalPicks          Int   @default(0) @map("total_picks")
  /// 정확 피킹 건수
  accuratePicks       Int   @default(0) @map("accurate_picks")

  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  slaTarget SlaTarget @relation(fields: [slaTargetId], references: [id])

  @@unique([slaTargetId, recordDate])
  @@index([slaTargetId, recordDate])
  @@map("sla_metrics")
}

/// SLA 위반 기록
model SlaViolation {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slaTargetId String   @map("sla_target_id") @db.Uuid
  /// 위반 지표 (delivery_on_time, misshipment_rate, picking_accuracy, avg_processing_time)
  metricName  String   @map("metric_name") @db.VarChar(50)
  /// 목표값
  targetValue Float    @map("target_value")
  /// 실측값
  actualValue Float    @map("actual_value")
  /// 위반 날짜
  violationDate DateTime @map("violation_date") @db.Date
  /// 심각도 (warning, critical)
  severity    String   @db.VarChar(20)
  /// 에스컬레이션 발송 여부
  escalated   Boolean  @default(false)
  /// 해결 여부
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  /// 메모
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  slaTarget SlaTarget @relation(fields: [slaTargetId], references: [id])

  @@index([slaTargetId, violationDate])
  @@index([metricName])
  @@map("sla_violations")
}

// ============================================================
// QC — 품질 검수 관리
// ============================================================

/// 공급업체
model Supplier {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(200)
  code      String   @db.VarChar(50)
  /// 연락처
  contact   String?  @db.VarChar(200)
  /// 이메일
  email     String?  @db.VarChar(255)
  /// 현재 등급 (A/B/C/D)
  grade     String   @default("B") @db.VarChar(5)
  /// 현재 품질 점수 (0~100)
  qualityScore Float @default(80) @map("quality_score")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  inspections QcInspection[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("suppliers")
}

/// 검수 기록
model QcInspection {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId     String   @map("site_id") @db.Uuid
  supplierId String?  @map("supplier_id") @db.Uuid
  /// 검수 유형 (INBOUND: 입고, OUTBOUND: 출고)
  type       String   @db.VarChar(20)
  /// 검수 상태 (PENDING, IN_PROGRESS, COMPLETED, FAILED)
  status     String   @default("PENDING") @db.VarChar(20)

  // --- 수량 ---
  /// 총 검수 수량
  totalQty     Int @default(0) @map("total_qty")
  /// 합격 수량
  passedQty    Int @default(0) @map("passed_qty")
  /// 불량 수량
  defectQty    Int @default(0) @map("defect_qty")
  /// 불량률 (%)
  defectRate   Float @default(0) @map("defect_rate")

  /// 참조 번호 (입고전표 번호 등)
  referenceNo  String? @map("reference_no") @db.VarChar(100)
  /// 검수자
  inspectorName String? @map("inspector_name") @db.VarChar(100)
  /// 검수 완료 시각
  inspectedAt  DateTime? @map("inspected_at") @db.Timestamptz
  /// 비고
  note         String?  @db.Text
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site     Site      @relation(fields: [siteId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  items    QcDefectItem[]

  @@index([siteId, type])
  @@index([supplierId])
  @@index([inspectedAt])
  @@map("qc_inspections")
}

/// 불량 항목 상세
model QcDefectItem {
  id           String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  inspectionId String @map("inspection_id") @db.Uuid
  /// 불량 유형 (DAMAGED: 파손, WRONG_ITEM: 오품, WRONG_QTY: 수량 불일치,
  ///            EXPIRED: 유통기한 초과, CONTAMINATED: 오염, PACKAGING: 포장 불량, OTHER: 기타)
  defectType   String @map("defect_type") @db.VarChar(30)
  /// 불량 수량
  qty          Int    @default(1)
  /// 상품명/SKU
  itemName     String? @map("item_name") @db.VarChar(200)
  itemSku      String? @map("item_sku") @db.VarChar(100)
  /// 격리 위치 (spatial_objects의 QUARANTINE_ZONE 참조 ID)
  quarantineLocationId String? @map("quarantine_location_id") @db.Uuid
  /// 처리 상태 (QUARANTINED: 격리, RETURNED: 반품, DISPOSED: 폐기, REWORKED: 재작업)
  disposition  String? @db.VarChar(20)
  /// 사진/증빙 URL
  evidenceUrl  String? @map("evidence_url") @db.Text
  note         String? @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  inspection QcInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([defectType])
  @@index([quarantineLocationId])
  @@map("qc_defect_items")
}

// ============================================================
// Picking — 피킹 작업 관리
// ============================================================

/// 피킹 주문 (출고 요청 단위)
model PickingOrder {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  /// 주문 번호
  orderNo   String   @map("order_no") @db.VarChar(100)
  /// 상태 (PENDING, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED)
  status    String   @default("PENDING") @db.VarChar(20)
  /// 출고 정책 (FIFO, FEFO, NEAREST)
  policy    String   @default("FIFO") @db.VarChar(20)
  /// 우선순위 (1=최고, 5=최저)
  priority  Int      @default(3)
  /// 배정된 작업자
  assigneeId   String?  @map("assignee_id") @db.Uuid
  assigneeName String?  @map("assignee_name") @db.VarChar(100)
  /// 고객명
  customerName String? @map("customer_name") @db.VarChar(200)
  /// 배정 시각
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz
  /// 피킹 시작 시각
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  /// 피킹 완료 시각
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  /// 총 라인 수
  totalLines   Int @default(0) @map("total_lines")
  /// 완료 라인 수
  pickedLines  Int @default(0) @map("picked_lines")
  /// 오류 라인 수
  errorLines   Int @default(0) @map("error_lines")
  note         String?  @db.Text
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site  Site          @relation(fields: [siteId], references: [id])
  lines PickingLine[]

  @@unique([siteId, orderNo])
  @@index([siteId, status])
  @@index([assigneeId])
  @@map("picking_orders")
}

/// 피킹 라인 (주문 내 개별 아이템)
model PickingLine {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pickingOrderId String   @map("picking_order_id") @db.Uuid
  /// 라인 번호 (순서)
  lineNo         Int      @map("line_no")
  /// 상품 SKU
  sku            String   @db.VarChar(100)
  /// 상품명
  itemName       String   @map("item_name") @db.VarChar(200)
  /// 요청 수량
  requestedQty   Int      @map("requested_qty")
  /// 실제 피킹 수량
  pickedQty      Int      @default(0) @map("picked_qty")
  /// 상태 (PENDING, PICKED, SHORT, ERROR, SKIPPED)
  status         String   @default("PENDING") @db.VarChar(20)

  // --- 위치 정보 (정책 엔진이 결정) ---
  /// 출발 bin 위치 ID (spatial_objects 참조)
  binLocationId  String?  @map("bin_location_id") @db.Uuid
  /// bin 코드 (사람이 읽을 수 있는 형태: A-01-03)
  binCode        String?  @map("bin_code") @db.VarChar(50)
  /// zone
  zone           String?  @db.VarChar(50)
  /// 바코드
  barcode        String?  @db.VarChar(100)
  /// 유통기한
  expiryDate     DateTime? @map("expiry_date") @db.Date
  /// 입고일
  receivedDate   DateTime? @map("received_date") @db.Date
  /// 피킹 순서 (경로 최적화 결과)
  pickSequence   Int      @default(0) @map("pick_sequence")

  /// 바코드 스캔 확인 여부
  scanVerified   Boolean  @default(false) @map("scan_verified")
  /// 피킹 완료 시각
  pickedAt       DateTime? @map("picked_at") @db.Timestamptz
  /// 오류 사유
  errorReason    String?  @map("error_reason") @db.VarChar(200)
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  pickingOrder PickingOrder @relation(fields: [pickingOrderId], references: [id], onDelete: Cascade)

  @@index([pickingOrderId])
  @@index([sku])
  @@index([binLocationId])
  @@map("picking_lines")
}

// ============================================================
// Alerts — 이상 탐지 알림
// ============================================================

/// 이상 탐지 알림 이벤트
model Alert {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId     String   @map("site_id") @db.Uuid
  /// 지표 유형 (inventory_level, picking_error_rate 등)
  metricType String   @map("metric_type") @db.VarChar(50)
  /// 심각도 (info, warning, critical)
  severity   String   @db.VarChar(20)
  title      String   @db.VarChar(300)
  message    String   @db.Text
  /// 이상 건수
  anomalyCount Int    @default(0) @map("anomaly_count")
  /// 확인 여부
  isRead     Boolean  @default(false) @map("is_read")
  /// 해결 여부
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  /// 탐지 통계 데이터
  metadata   Json?    @db.JsonB
  detectedAt DateTime @map("detected_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id])

  @@index([siteId, severity])
  @@index([siteId, metricType])
  @@index([detectedAt])
  @@map("alerts")
}

/// 공간 계층 구조 (부모-자식 관계)
model SpatialHierarchy {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parentId  String   @map("parent_id") @db.Uuid
  childId   String   @map("child_id") @db.Uuid
  /// 정렬 순서
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  parent SpatialObject @relation("ParentObject", fields: [parentId], references: [id], onDelete: Cascade)
  child  SpatialObject @relation("ChildObject", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
  @@map("spatial_hierarchies")
}

// ============================================================
// Phase 3 — Logistics ERP (경량 ERP)
// ============================================================

/// 거래처 (공급업체 + 고객사)
model Partner {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  /// 거래처 유형 (SUPPLIER: 공급업체, CUSTOMER: 고객사, BOTH: 양쪽)
  type        String   @db.VarChar(20)
  name        String   @db.VarChar(200)
  code        String   @db.VarChar(50)
  /// 사업자등록번호
  bizNo       String?  @map("biz_no") @db.VarChar(20)
  /// 대표자명
  ceoName     String?  @map("ceo_name") @db.VarChar(100)
  /// 업태
  bizType     String?  @map("biz_type") @db.VarChar(100)
  /// 종목
  bizCategory String?  @map("biz_category") @db.VarChar(100)
  address     String?  @db.Text
  phone       String?  @db.VarChar(30)
  email       String?  @db.VarChar(255)
  /// 담당자명
  contactName String?  @map("contact_name") @db.VarChar(100)
  /// 결제 조건 (ex: NET30, COD)
  paymentTerms String? @map("payment_terms") @db.VarChar(30)
  /// 메모
  note        String?  @db.Text

  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company     Company   @relation(fields: [companyId], references: [id])
  vouchers    Voucher[]
  leadTimes   SupplierLeadTime[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@map("partners")
}

/// 전표 (매입/매출)
model Voucher {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  /// 전표 유형 (PURCHASE: 매입, SALES: 매출)
  type        String   @db.VarChar(20)
  /// 전표 번호 (자동 생성)
  voucherNo   String   @unique @map("voucher_no") @db.VarChar(30)
  /// 거래처 ID
  partnerId   String   @map("partner_id") @db.Uuid
  /// 전표 상태 (DRAFT, CONFIRMED, CANCELED)
  status      String   @default("DRAFT") @db.VarChar(20)
  /// 전표 일자
  voucherDate DateTime @map("voucher_date") @db.Date
  /// 납기일
  dueDate     DateTime? @map("due_date") @db.Date
  /// 공급가액 합계 (원)
  subtotal    Int      @default(0)
  /// 부가세 합계 (원)
  taxAmount   Int      @default(0) @map("tax_amount")
  /// 총액 (공급가 + 부가세)
  totalAmount Int      @default(0) @map("total_amount")
  /// 참조 번호 (입고/출고 전표 연계)
  referenceNo String?  @map("reference_no") @db.VarChar(50)
  /// 비고
  note        String?  @db.Text
  /// 확정 일시
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  partner     Partner       @relation(fields: [partnerId], references: [id])
  lines       VoucherLine[]

  @@index([siteId, type])
  @@index([siteId, voucherDate])
  @@index([partnerId])
  @@map("vouchers")
}

/// 전표 항목
model VoucherLine {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  voucherId   String   @map("voucher_id") @db.Uuid
  lineNo      Int      @map("line_no")
  sku         String   @db.VarChar(50)
  itemName    String   @map("item_name") @db.VarChar(200)
  /// 수량
  qty         Int
  /// 단가 (원)
  unitPrice   Int      @map("unit_price")
  /// 공급가 = qty × unitPrice
  amount      Int
  /// 부가세
  taxAmount   Int      @default(0) @map("tax_amount")
  /// 비고
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([sku])
  @@map("voucher_lines")
}

/// SKU별 원가 정보
model SkuCost {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  sku         String   @db.VarChar(50)
  itemName    String   @map("item_name") @db.VarChar(200)
  /// 원가 계산 방식 (FIFO, MOVING_AVG)
  costMethod  String   @default("FIFO") @map("cost_method") @db.VarChar(20)
  /// 현재 재고 수량
  currentQty  Int      @default(0) @map("current_qty")
  /// FIFO: 현재 로트별 원가 배열 [{ qty, unitCost }]
  fifoLayers  Json?    @map("fifo_layers") @db.JsonB
  /// 이동평균: 현재 평균 단가 (원)
  avgUnitCost Float    @default(0) @map("avg_unit_cost")
  /// 최종 매입 단가 (원)
  lastPurchasePrice Int @default(0) @map("last_purchase_price")
  /// 표준 판매 단가 (원)
  sellingPrice Int     @default(0) @map("selling_price")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([siteId, sku])
  @@index([siteId])
  @@map("sku_costs")
}

// ============================================================
// Phase 3 Step 2 — HS 코드 글로벌 무역 인텔리전스
// ============================================================

/// HS 코드 마스터 (6자리 기준)
model HsCodeMaster {
  hsCode        String @id @map("hs_code") @db.VarChar(10)
  /// 한국어 품목 설명
  description   String @db.VarChar(500)
  /// 영문 품목 설명
  descriptionEn String @map("description_en") @db.VarChar(500)
  /// 챕터 (2자리, 예: "87")
  chapter       String @db.VarChar(2)
  /// 헤딩 (4자리, 예: "8703")
  heading       String @db.VarChar(4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([chapter])
  @@index([heading])
  @@map("hs_code_master")
}

/// 유저 HS 코드 즐겨찾기
model HsCodeWatch {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  /// HS 코드 (6자리)
  hsCode        String   @map("hs_code") @db.VarChar(10)
  /// 품목 설명
  description   String   @db.VarChar(500)
  /// 영문 품목 설명
  descriptionEn String?  @map("description_en") @db.VarChar(500)
  /// 주요 관심 코드 여부
  isMain        Boolean  @default(false) @map("is_main")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([companyId, hsCode])
  @@index([companyId])
  @@map("hs_code_watch")
}

/// 수집된 무역 데이터 캐시 (TTL 관리)
model TradeDataCache {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// HS 코드 (6자리)
  hsCode      String   @map("hs_code") @db.VarChar(10)
  /// 보고국 ISO3 코드
  reporterIso String   @map("reporter_iso") @db.VarChar(3)
  /// 상대국 ISO3 코드
  partnerIso  String   @map("partner_iso") @db.VarChar(3)
  /// 기간 (YYYY-MM 형식)
  period      String   @db.VarChar(7)
  /// 수출/수입 (EXPORT | IMPORT)
  flowType    String   @map("flow_type") @db.VarChar(10)
  /// 교역 금액 (USD)
  valueUsd    Float    @map("value_usd")
  /// 중량 (kg)
  weightKg    Float?   @map("weight_kg")
  /// 데이터 소스 (UN_COMTRADE | KR_CUSTOMS | US_CENSUS | EU_EUROSTAT)
  source      String   @db.VarChar(20)
  /// 수집 시각
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz
  /// 캐시 만료 시각
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  @@unique([hsCode, reporterIso, partnerIso, period, flowType])
  @@index([hsCode])
  @@index([expiresAt])
  @@map("trade_data_cache")
}

/// 유저 HS 코드 검색 로그
model HsSearchLog {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 회사 ID (비로그인 시 null)
  companyId   String?  @map("company_id") @db.Uuid
  /// 검색한 HS 코드
  hsCode      String   @map("hs_code") @db.VarChar(10)
  /// 보고국 ISO3 코드
  reporterIso String   @map("reporter_iso") @db.VarChar(3)
  /// 검색 시각
  searchedAt  DateTime @default(now()) @map("searched_at") @db.Timestamptz
  /// 결과 건수
  resultCount Int      @default(0) @map("result_count")
  /// 캐시 히트 여부
  cacheHit    Boolean  @default(false) @map("cache_hit")

  @@index([hsCode])
  @@index([searchedAt])
  @@map("hs_search_log")
}

/// HS 코드별 선점 현황 (데이터 플라이휠 추적)
model HsCodeCoverage {
  /// HS 코드 (6자리, PK)
  hsCode          String    @id @map("hs_code") @db.VarChar(10)
  /// 마지막 수집 시각
  lastFetchedAt   DateTime? @map("last_fetched_at") @db.Timestamptz
  /// 총 수집 횟수
  fetchCount      Int       @default(0) @map("fetch_count")
  /// 유저 검색 횟수
  searchCount     Int       @default(0) @map("search_count")
  /// 우선순위 점수
  priority        Float     @default(0)
  /// 인기 코드 여부 (검색 10회 이상)
  isPopular       Boolean   @default(false) @map("is_popular")
  /// 캐시 보유 국가 ISO3 목록
  countriesCached String[]  @map("countries_cached")
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("hs_code_coverage")
}

/// 야간 배치 실행 로그
model PrefetchBatchLog {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 실행 시각
  runAt        DateTime @default(now()) @map("run_at") @db.Timestamptz
  /// 사용한 API 호출 수
  callsUsed    Int      @map("calls_used")
  /// 새로 추가한 코드 수
  codesAdded   Int      @map("codes_added")
  /// 캐시 히트율 (%)
  cacheHitRate Float    @map("cache_hit_rate")
  /// 전략 (POPULAR: 인기갱신, ADJACENT: 인접선점, RANDOM: 랜덤탐색)
  strategy     String   @db.VarChar(20)

  @@index([runAt])
  @@map("prefetch_batch_log")
}

// ============================================================
// Phase 3 Step 3 — 자동 발주 추천 엔진
// ============================================================

/// SKU별 출고 이력 (수요 예측용 일별 집계)
model SkuDailyUsage {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  sku       String   @db.VarChar(50)
  /// 날짜
  usageDate DateTime @map("usage_date") @db.Date
  /// 출고 수량
  qtyUsed   Int      @map("qty_used")
  /// 입고 수량 (리드타임 계산용)
  qtyReceived Int    @default(0) @map("qty_received")

  @@unique([siteId, sku, usageDate])
  @@index([siteId, sku])
  @@index([usageDate])
  @@map("sku_daily_usage")
}

/// 공급업체 리드타임 학습 기록
model SupplierLeadTime {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  /// 공급업체 ID (Partner)
  partnerId   String   @map("partner_id") @db.Uuid
  sku         String   @db.VarChar(50)
  /// 발주일
  orderDate   DateTime @map("order_date") @db.Date
  /// 입고 완료일
  receivedDate DateTime? @map("received_date") @db.Date
  /// 실제 리드타임 (영업일 기준)
  actualDays  Int?     @map("actual_days")
  /// 발주 수량
  orderQty    Int      @map("order_qty")
  /// 발주 전표 번호
  voucherNo   String?  @map("voucher_no") @db.VarChar(30)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  partner     Partner  @relation(fields: [partnerId], references: [id])

  @@index([siteId, sku])
  @@index([partnerId])
  @@index([orderDate])
  @@map("supplier_lead_times")
}

/// 수요 예측 결과
model DemandForecast {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  sku         String   @db.VarChar(50)
  /// 예측 기간 (7, 14, 30일)
  horizon     Int
  /// 예측 일별 수요량 (JSON 배열: [{date, qty}])
  dailyForecast Json  @map("daily_forecast") @db.JsonB
  /// 예측 합계 수량
  totalForecast Int   @map("total_forecast")
  /// 예측 모델 (LINEAR, PROPHET, MOVING_AVG)
  model       String   @db.VarChar(20)
  /// 예측 정확도 (MAPE, %)
  mape        Float?
  /// 예측 생성 시각
  forecastedAt DateTime @default(now()) @map("forecasted_at") @db.Timestamptz

  @@index([siteId, sku])
  @@index([forecastedAt])
  @@map("demand_forecasts")
}

/// 발주 추천
model ReorderRecommendation {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId        String   @map("site_id") @db.Uuid
  sku           String   @db.VarChar(50)
  itemName      String   @map("item_name") @db.VarChar(200)
  /// 현재 재고 수량
  currentQty    Int      @map("current_qty")
  /// 안전 재고 수량
  safetyStock   Int      @map("safety_stock")
  /// 예상 소진일
  stockoutDate  DateTime? @map("stockout_date") @db.Date
  /// 소진까지 남은 일수
  daysUntilOut  Int?     @map("days_until_out")
  /// 추천 발주량
  reorderQty    Int      @map("reorder_qty")
  /// 추천 공급업체 ID
  partnerId     String?  @map("partner_id") @db.Uuid
  /// 추천 공급업체명
  partnerName   String?  @map("partner_name") @db.VarChar(200)
  /// 공급업체 평균 리드타임
  avgLeadDays   Int?     @map("avg_lead_days")
  /// 추천 발주일 ("지금 발주하면 납기 맞춤")
  orderByDate   DateTime? @map("order_by_date") @db.Date
  /// 긴급도 (LOW, MEDIUM, HIGH, CRITICAL)
  urgency       String   @db.VarChar(20)
  /// 추천 상태 (PENDING, ACCEPTED, DISMISSED, AUTO_ORDERED)
  status        String   @default("PENDING") @db.VarChar(20)
  /// 자동 생성된 전표 ID
  voucherId     String?  @map("voucher_id") @db.Uuid
  /// 예측 기반 정보 (JSON)
  forecastMeta  Json?    @map("forecast_meta") @db.JsonB

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([siteId, urgency])
  @@index([siteId, sku])
  @@index([status])
  @@index([stockoutDate])
  @@map("reorder_recommendations")
}

// ============================================================
// Phase 3 Step 4 — 더존/영림원 ERP 커넥터
// ============================================================

/// ERP 커넥터 설정 (회사별)
model ErpConnectorConfig {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  /// 커넥터 유형 (DOUZON, YOUNGLIMWON)
  erpType       String   @map("erp_type") @db.VarChar(20)
  /// 표시 이름
  displayName   String   @map("display_name") @db.VarChar(100)
  /// API 접속 URL
  baseUrl       String   @map("base_url") @db.VarChar(500)
  /// 인증 방식 (OAUTH2, API_KEY, BASIC)
  authType      String   @map("auth_type") @db.VarChar(20)
  /// 인증 정보 (암호화 저장: clientId, clientSecret, apiKey 등)
  credentials   Json     @db.JsonB
  /// 추가 설정 (companyCode, 타임존 등)
  configJson    Json?    @map("config_json") @db.JsonB
  /// 연동 활성 여부
  isActive      Boolean  @default(true) @map("is_active")
  /// 마지막 연결 확인 시각
  lastPingAt    DateTime? @map("last_ping_at") @db.Timestamptz
  /// 마지막 연결 상태 (OK, ERROR, TIMEOUT)
  lastPingStatus String? @map("last_ping_status") @db.VarChar(20)

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company       Company  @relation(fields: [companyId], references: [id])
  syncLogs      ErpSyncLog[]
  fieldMappings ErpFieldMapping[]

  @@unique([companyId, erpType])
  @@index([companyId])
  @@map("erp_connector_configs")
}

/// ERP 동기화 로그
model ErpSyncLog {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  connectorId   String   @map("connector_id") @db.Uuid
  /// 동기화 방향 (PUSH: HanVoxel→ERP, PULL: ERP→HanVoxel)
  direction     String   @db.VarChar(10)
  /// 동기화 대상 (VOUCHER, PARTNER, INVENTORY, RECEIPT)
  entityType    String   @map("entity_type") @db.VarChar(20)
  /// 대상 레코드 ID (HanVoxel 측)
  entityId      String?  @map("entity_id") @db.Uuid
  /// ERP 측 전표/레코드 번호
  erpRefNo      String?  @map("erp_ref_no") @db.VarChar(50)
  /// 동기화 상태 (SUCCESS, FAILED, RETRYING, SKIPPED)
  status        String   @db.VarChar(20)
  /// 오류 메시지
  errorMessage  String?  @map("error_message") @db.Text
  /// 재시도 횟수
  retryCount    Int      @default(0) @map("retry_count")
  /// 요청 페이로드 (디버깅용)
  requestPayload Json?   @map("request_payload") @db.JsonB
  /// 응답 페이로드
  responsePayload Json?  @map("response_payload") @db.JsonB

  syncedAt      DateTime @default(now()) @map("synced_at") @db.Timestamptz

  connector     ErpConnectorConfig @relation(fields: [connectorId], references: [id])

  @@index([connectorId, status])
  @@index([connectorId, entityType])
  @@index([syncedAt])
  @@map("erp_sync_logs")
}

/// ERP 필드 매핑 (커스터마이징)
model ErpFieldMapping {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  connectorId   String   @map("connector_id") @db.Uuid
  /// 대상 엔티티 (VOUCHER, PARTNER, ITEM)
  entityType    String   @map("entity_type") @db.VarChar(20)
  /// HanVoxel 필드명
  sourceField   String   @map("source_field") @db.VarChar(100)
  /// ERP 필드명
  targetField   String   @map("target_field") @db.VarChar(100)
  /// 변환 규칙 (DIRECT, FORMAT, LOOKUP, CONSTANT)
  transformType String   @default("DIRECT") @map("transform_type") @db.VarChar(20)
  /// 변환 파라미터 (포맷 문자열, 룩업 테이블 등)
  transformParam String? @map("transform_param") @db.VarChar(500)
  /// 필수 여부
  isRequired    Boolean  @default(false) @map("is_required")

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  connector     ErpConnectorConfig @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, entityType, sourceField])
  @@index([connectorId])
  @@map("erp_field_mappings")
}
