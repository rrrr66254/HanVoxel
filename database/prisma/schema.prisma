/// SKU별 출고 이력 (수요 예측용 일별 집계)
model SkuDailyUsage {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  sku         String   @db.VarChar(50)
  /// 날짜
  usageDate   DateTime @map("usage_date") @db.Date
  /// 출고 수량
  qtyUsed     Int      @map("qty_used")
  /// 입고 수량 (리드타임 계산용)
  qtyReceived Int      @default(0) @map("qty_received")

  @@unique([siteId, sku, usageDate])
  @@index([siteId, sku])
  @@index([usageDate])
  @@map("sku_daily_usage")
}

/// 공급업체 리드타임 학습 기록
model SupplierLeadTime {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId       String    @map("site_id") @db.Uuid
  /// 공급업체 ID (Partner)
  partnerId    String    @map("partner_id") @db.Uuid
  sku          String    @db.VarChar(50)
  /// 발주일
  orderDate    DateTime  @map("order_date") @db.Date
  /// 입고 완료일
  receivedDate DateTime? @map("received_date") @db.Date
  /// 실제 리드타임 (영업일 기준)
  actualDays   Int?      @map("actual_days")
  /// 발주 수량
  orderQty     Int       @map("order_qty")
  /// 발주 전표 번호
  voucherNo    String?   @map("voucher_no") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([siteId, sku])
  @@index([partnerId])
  @@index([orderDate])
  @@map("supplier_lead_times")
}

/// 수요 예측 결과
model DemandForecast {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId        String   @map("site_id") @db.Uuid
  sku           String   @db.VarChar(50)
  /// 예측 기간 (7, 14, 30일)
  horizon       Int
  /// 예측 일별 수요량 (JSON 배열: [{date, qty}])
  dailyForecast Json     @map("daily_forecast") @db.JsonB
  /// 예측 합계 수량
  totalForecast Int      @map("total_forecast")
  /// 예측 모델 (LINEAR, PROPHET, MOVING_AVG)
  model         String   @db.VarChar(20)
  /// 예측 정확도 (MAPE, %)
  mape          Float?
  /// 예측 생성 시각
  forecastedAt  DateTime @default(now()) @map("forecasted_at") @db.Timestamptz

  @@index([siteId, sku])
  @@index([forecastedAt])
  @@map("demand_forecasts")
}

/// 발주 추천
model ReorderRecommendation {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId       String    @map("site_id") @db.Uuid
  sku          String    @db.VarChar(50)
  itemName     String    @map("item_name") @db.VarChar(200)
  /// 현재 재고 수량
  currentQty   Int       @map("current_qty")
  /// 안전 재고 수량
  safetyStock  Int       @map("safety_stock")
  /// 예상 소진일
  stockoutDate DateTime? @map("stockout_date") @db.Date
  /// 소진까지 남은 일수
  daysUntilOut Int?      @map("days_until_out")
  /// 추천 발주량
  reorderQty   Int       @map("reorder_qty")
  /// 추천 공급업체 ID
  partnerId    String?   @map("partner_id") @db.Uuid
  /// 추천 공급업체명
  partnerName  String?   @map("partner_name") @db.VarChar(200)
  /// 공급업체 평균 리드타임
  avgLeadDays  Int?      @map("avg_lead_days")
  /// 추천 발주일 ("지금 발주하면 납기 맞춤")
  orderByDate  DateTime? @map("order_by_date") @db.Date
  /// 긴급도 (LOW, MEDIUM, HIGH, CRITICAL)
  urgency      String    @db.VarChar(20)
  /// 추천 상태 (PENDING, ACCEPTED, DISMISSED, AUTO_ORDERED)
  status       String    @default("PENDING") @db.VarChar(20)
  /// 자동 생성된 전표 ID
  voucherId    String?   @map("voucher_id") @db.Uuid
  /// 예측 기반 정보 (JSON)
  forecastMeta Json?     @map("forecast_meta") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([siteId, urgency])
  @@index([siteId, sku])
  @@index([status])
  @@index([stockoutDate])
  @@map("reorder_recommendations")
}

// ============================================================
// Phase 3 Step 4 — 더존/영림원 ERP 커넥터
// ============================================================

/// ERP 커넥터 설정 (회사별)
model ErpConnectorConfig {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  /// 커넥터 유형 (DOUZON, YOUNGLIMWON)
  erpType        String    @map("erp_type") @db.VarChar(20)
  /// 표시 이름
  displayName    String    @map("display_name") @db.VarChar(100)
  /// API 접속 URL
  baseUrl        String    @map("base_url") @db.VarChar(500)
  /// 인증 방식 (OAUTH2, API_KEY, BASIC)
  authType       String    @map("auth_type") @db.VarChar(20)
  /// 인증 정보 (암호화 저장: clientId, clientSecret, apiKey 등)
  credentials    Json      @db.JsonB
  /// 추가 설정 (companyCode, 타임존 등)
  configJson     Json?     @map("config_json") @db.JsonB
  /// 연동 활성 여부
  isActive       Boolean   @default(true) @map("is_active")
  /// 마지막 연결 확인 시각
  lastPingAt     DateTime? @map("last_ping_at") @db.Timestamptz
  /// 마지막 연결 상태 (OK, ERROR, TIMEOUT)
  lastPingStatus String?   @map("last_ping_status") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company       Company           @relation(fields: [companyId], references: [id])
  syncLogs      ErpSyncLog[]
  fieldMappings ErpFieldMapping[]

  @@unique([companyId, erpType])
  @@index([companyId])
  @@map("erp_connector_configs")
}

/// ERP 동기화 로그
model ErpSyncLog {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  connectorId     String  @map("connector_id") @db.Uuid
  /// 동기화 방향 (PUSH: HanVoxel→ERP, PULL: ERP→HanVoxel)
  direction       String  @db.VarChar(10)
  /// 동기화 대상 (VOUCHER, PARTNER, INVENTORY, RECEIPT)
  entityType      String  @map("entity_type") @db.VarChar(20)
  /// 대상 레코드 ID (HanVoxel 측)
  entityId        String? @map("entity_id") @db.Uuid
  /// ERP 측 전표/레코드 번호
  erpRefNo        String? @map("erp_ref_no") @db.VarChar(50)
  /// 동기화 상태 (SUCCESS, FAILED, RETRYING, SKIPPED)
  status          String  @db.VarChar(20)
  /// 오류 메시지
  errorMessage    String? @map("error_message") @db.Text
  /// 재시도 횟수
  retryCount      Int     @default(0) @map("retry_count")
  /// 요청 페이로드 (디버깅용)
  requestPayload  Json?   @map("request_payload") @db.JsonB
  /// 응답 페이로드
  responsePayload Json?   @map("response_payload") @db.JsonB

  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz

  connector ErpConnectorConfig @relation(fields: [connectorId], references: [id])

  @@index([connectorId, status])
  @@index([connectorId, entityType])
  @@index([syncedAt])
  @@map("erp_sync_logs")
}

/// ERP 필드 매핑 (커스터마이징)
model ErpFieldMapping {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  connectorId    String  @map("connector_id") @db.Uuid
  /// 대상 엔티티 (VOUCHER, PARTNER, ITEM)
  entityType     String  @map("entity_type") @db.VarChar(20)
  /// HanVoxel 필드명
  sourceField    String  @map("source_field") @db.VarChar(100)
  /// ERP 필드명
  targetField    String  @map("target_field") @db.VarChar(100)
  /// 변환 규칙 (DIRECT, FORMAT, LOOKUP, CONSTANT)
  transformType  String  @default("DIRECT") @map("transform_type") @db.VarChar(20)
  /// 변환 파라미터 (포맷 문자열, 룩업 테이블 등)
  transformParam String? @map("transform_param") @db.VarChar(500)
  /// 필수 여부
  isRequired     Boolean @default(false) @map("is_required")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  connector ErpConnectorConfig @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, entityType, sourceField])
  @@index([connectorId])
  @@map("erp_field_mappings")
}

// ============================================================
// Phase 3 Step 5 — 업계 벤치마크
// ============================================================

/// 업계 벤치마크 스냅샷 (월별 익명 집계)
model BenchmarkSnapshot {
  id               String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 집계 기간 (YYYY-MM)
  period           String @db.VarChar(7)
  /// 업종 (AUTO_PARTS, FOOD_BEVERAGE, ELECTRONICS 등)
  industry         String @db.VarChar(50)
  /// 회사 규모 (SMALL, MEDIUM, LARGE)
  companySize      String @map("company_size") @db.VarChar(20)
  /// 참여 회사 수 (익명성 보장: 최소 5 이상)
  participantCount Int    @map("participant_count")

  // ── 핵심 KPI 평균 ──
  /// 피킹 정확도 (%) 평균
  avgPickingAccuracy   Float @default(0) @map("avg_picking_accuracy")
  /// 재고회전율 (회/년) 평균
  avgInventoryTurnover Float @default(0) @map("avg_inventory_turnover")
  /// 공간활용률 (%) 평균
  avgSpaceUtilization  Float @default(0) @map("avg_space_utilization")
  /// 납기준수율 (%) 평균
  avgOnTimeDelivery    Float @default(0) @map("avg_on_time_delivery")
  /// 입고처리 시간 (시간) 평균
  avgReceivingTime     Float @default(0) @map("avg_receiving_time")
  /// 주문처리 시간 (시간) 평균
  avgOrderCycleTime    Float @default(0) @map("avg_order_cycle_time")

  // ── 분포 (백분위) ──
  /// 각 KPI의 P25, P50, P75, P90 값 (JSON)
  percentiles Json @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([period, industry, companySize])
  @@index([industry])
  @@index([period])
  @@map("benchmark_snapshots")
}

/// 개별 회사 벤치마크 지표 (월별)
model CompanyBenchmark {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String @map("company_id") @db.Uuid
  siteId      String @map("site_id") @db.Uuid
  /// 집계 기간 (YYYY-MM)
  period      String @db.VarChar(7)
  /// 업종
  industry    String @db.VarChar(50)
  /// 회사 규모
  companySize String @map("company_size") @db.VarChar(20)

  // ── 내 지표 ──
  pickingAccuracy   Float @default(0) @map("picking_accuracy")
  inventoryTurnover Float @default(0) @map("inventory_turnover")
  spaceUtilization  Float @default(0) @map("space_utilization")
  onTimeDelivery    Float @default(0) @map("on_time_delivery")
  receivingTime     Float @default(0) @map("receiving_time")
  orderCycleTime    Float @default(0) @map("order_cycle_time")

  // ── 업계 대비 순위 ──
  /// 업계 상위 퍼센트 (JSON: { pickingAccuracy: 15, ... })
  percentileRanks Json  @default("{}") @map("percentile_ranks") @db.JsonB
  /// 종합 점수 (100점 만점)
  overallScore    Float @default(0) @map("overall_score")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([companyId, siteId, period])
  @@index([companyId])
  @@index([period, industry])
  @@map("company_benchmarks")
}

/// 벤치마크 리포트 (PDF 생성 이력)
model BenchmarkReport {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId       String  @map("company_id") @db.Uuid
  siteId          String  @map("site_id") @db.Uuid
  /// 리포트 기간 (YYYY-MM)
  period          String  @db.VarChar(7)
  /// 리포트 제목
  title           String  @db.VarChar(200)
  /// 리포트 JSON 데이터 (PDF 생성 원본)
  reportData      Json    @map("report_data") @db.JsonB
  /// 개선 권고 사항 (JSON 배열)
  recommendations Json    @default("[]") @db.JsonB
  /// PDF 파일 경로 (S3 또는 로컬)
  pdfUrl          String? @map("pdf_url") @db.VarChar(500)
  /// 생성 상태 (PENDING, GENERATED, FAILED)
  status          String  @default("PENDING") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId, period])
  @@map("benchmark_reports")
}

// ============================================================
// ROI Tracking — 실제 절감 추적 (Phase 4)
// ============================================================

/// ROI 기준선 (HanVoxel 도입 전 운영 지표 스냅샷)
model RoiBaseline {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  siteId    String @map("site_id") @db.Uuid

  /// 기준선 설정일
  baselineDate DateTime @map("baseline_date") @db.Timestamptz

  // ── 도입 전 비용 ──
  /// 연간 인건비 (원)
  annualLaborCost  BigInt @default(0) @map("annual_labor_cost")
  /// 연간 오류 비용 (원)
  annualErrorCost  BigInt @default(0) @map("annual_error_cost")
  /// m²당 월 임대료 (원)
  monthlyRentPerM2 Int    @default(0) @map("monthly_rent_per_m2")
  /// 창고 면적 (m²)
  warehouseArea    Float  @default(0) @map("warehouse_area")

  // ── 도입 전 운영 지표 ──
  /// 월 피킹 건수
  monthlyPickings Int   @default(0) @map("monthly_pickings")
  /// 오류율 (%)
  errorRate       Float @default(0) @map("error_rate")
  /// 직원 수
  employeeCount   Int   @default(0) @map("employee_count")

  // ── 예상 개선율 (설정 시점 입력값) ──
  /// 인건비 절감율 (%)
  laborSavingRate       Float @default(15) @map("labor_saving_rate")
  /// 오류율 감소율 (%)
  errorReductionRate    Float @default(60) @map("error_reduction_rate")
  /// 공간 절감율 (%)
  spaceSavingRate       Float @default(10) @map("space_saving_rate")
  /// 피킹 효율 개선율 (%)
  pickingEfficiencyGain Float @default(25) @map("picking_efficiency_gain")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  snapshots RoiMonthlySnapshot[]

  @@unique([companyId, siteId])
  @@index([companyId])
  @@map("roi_baselines")
}

/// ROI 월별 스냅샷 (실제 운영 데이터 기반 절감 추적)
model RoiMonthlySnapshot {
  id         String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  baselineId String @map("baseline_id") @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  siteId     String @map("site_id") @db.Uuid

  /// 집계 기간 (YYYY-MM)
  period String @db.VarChar(7)

  // ── 실제 운영 지표 (DB에서 자동 집계) ──
  /// 월 피킹 건수 (picking_orders 테이블에서 집계)
  actualPickings      Int   @default(0) @map("actual_pickings")
  /// 월 오류 건수 (picking_lines 중 오류 건)
  actualErrors        Int   @default(0) @map("actual_errors")
  /// 실제 오류율 (%)
  actualErrorRate     Float @default(0) @map("actual_error_rate")
  /// 현재 직원 수
  actualEmployeeCount Int   @default(0) @map("actual_employee_count")

  // ── 사용자 입력 실제 비용 ──
  /// 해당월 인건비 (원)
  actualLaborCost BigInt @default(0) @map("actual_labor_cost")
  /// 해당월 오류 비용 (원)
  actualErrorCost BigInt @default(0) @map("actual_error_cost")

  // ── 자동 계산된 절감액 ──
  /// 인건비 절감액 (기준선 월할 - 실제)
  laborSaving     BigInt @default(0) @map("labor_saving")
  /// 오류 비용 절감액
  errorCostSaving BigInt @default(0) @map("error_cost_saving")
  /// 공간 절감액 (기준선 기반 추정)
  spaceSaving     BigInt @default(0) @map("space_saving")
  /// 월 총 절감액
  totalSaving     BigInt @default(0) @map("total_saving")

  // ── 누적 ──
  /// 도입 이후 누적 절감액
  cumulativeSaving BigInt @default(0) @map("cumulative_saving")

  /// 데이터 소스 (AUTO: DB 자동집계, MANUAL: 수동입력, MIXED: 혼합)
  dataSource String @default("AUTO") @map("data_source") @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  baseline RoiBaseline @relation(fields: [baselineId], references: [id])

  @@unique([baselineId, period])
  @@index([companyId, period])
  @@map("roi_monthly_snapshots")
}

// ============================================================
// 입출고 관리 — Inbound / Outbound Orders
// ============================================================

/// 입고 주문
model InboundOrder {
  id                      String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId                  String    @map("site_id") @db.Uuid
  /// 자동발주 추천 연동 ID
  reorderRecommendationId String?   @map("reorder_recommendation_id") @db.Uuid
  /// 공급업체 (Partner) ID
  vendorId                String?   @map("vendor_id") @db.Uuid
  /// 공급업체명 (검색·표시용 비정규화)
  vendorName              String?   @map("vendor_name") @db.VarChar(200)
  /// 상태: ORDERED → IN_TRANSIT → ARRIVED → QC_PENDING → QC_PASSED → STOCKED
  status                  String    @default("ORDERED") @db.VarChar(20)
  /// 입고 예상일
  expectedDate            DateTime? @map("expected_date") @db.Date
  /// 실제 입고일
  actualDate              DateTime? @map("actual_date") @db.Date
  /// 비고
  notes                   String?   @db.Text

  /// 배송 기사 ID
  driverId       String? @map("driver_id") @db.Uuid
  /// 배송 기사명
  driverName     String? @map("driver_name") @db.VarChar(100)
  /// 배송 기사 연락처
  driverPhone    String? @map("driver_phone") @db.VarChar(30)
  /// 운송사
  carrierCompany String? @map("carrier_company") @db.VarChar(100)
  /// 차량 번호
  vehicleNo      String? @map("vehicle_no") @db.VarChar(30)
  /// 배송 추적 URL
  trackingUrl    String? @map("tracking_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  items    InboundItem[]
  calendar DeliveryCalendar[]
  driver   DeliveryDriver?    @relation(fields: [driverId], references: [id])

  @@index([siteId, status])
  @@index([siteId, expectedDate])
  @@index([vendorId])
  @@index([driverId])
  @@map("inbound_orders")
}

/// 입고 품목 명세
model InboundItem {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  inboundOrderId  String  @map("inbound_order_id") @db.Uuid
  /// 상품 SKU
  sku             String  @map("sku_code") @db.VarChar(100)
  /// 상품명
  itemName        String? @map("item_name") @db.VarChar(200)
  /// 예상 수량
  expectedQty     Int     @map("expected_qty")
  /// 실제 수량
  actualQty       Int?    @map("actual_qty")
  /// 단가 (원)
  unitPrice       Int     @default(0) @map("unit_price")
  /// QC 검수 연동 ID
  qcInspectionId  String? @map("qc_inspection_id") @db.Uuid
  /// 배치될 랙/BIN 공간 객체 ID
  spatialObjectId String? @map("spatial_object_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  inboundOrder InboundOrder @relation(fields: [inboundOrderId], references: [id], onDelete: Cascade)

  @@index([inboundOrderId])
  @@index([sku])
  @@map("inbound_items")
}

/// 출고 주문
model OutboundOrder {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId         String    @map("site_id") @db.Uuid
  /// 출고 유형: PICKING | PALLET | CONTAINER | DIRECT | TRANSFER
  type           String    @default("PICKING") @db.VarChar(20)
  /// 상태: PLANNED → PICKING → PACKED → DISPATCHED
  status         String    @default("PLANNED") @db.VarChar(20)
  /// 출고 예정일
  scheduledDate  DateTime? @map("scheduled_date") @db.Date
  /// 실제 출고일
  dispatchedDate DateTime? @map("dispatched_date") @db.Date
  /// 고객명
  customerName   String?   @map("customer_name") @db.VarChar(200)
  /// 배송지
  destination    String?   @db.Text
  /// 명세표 번호 (OUT-YYYYMMDD-XXXX)
  manifestNumber String?   @unique @map("manifest_number") @db.VarChar(30)
  /// 타임슬롯 (AM / PM / NIGHT / CUSTOM)
  timeSlot       String?   @map("time_slot") @db.VarChar(20)
  /// 비고
  notes          String?   @db.Text
  /// 컨테이너 규격 (CONTAINER 유형 시)
  containerSpec  String?   @map("container_spec") @db.VarChar(30)
  /// HS 코드 (수출 시)
  hsCode         String?   @map("hs_code") @db.VarChar(10)

  /// 거래처 (고객사) ID
  customerId      String? @map("customer_id") @db.Uuid
  /// 수령인 이름
  receiverName    String? @map("receiver_name") @db.VarChar(100)
  /// 수령인 연락처
  receiverPhone   String? @map("receiver_phone") @db.VarChar(30)
  /// 수령인 주소
  receiverAddress String? @map("receiver_address") @db.Text

  /// 배송 기사 ID
  driverId       String? @map("driver_id") @db.Uuid
  /// 배송 기사명
  driverName     String? @map("driver_name") @db.VarChar(100)
  /// 배송 기사 연락처
  driverPhone    String? @map("driver_phone") @db.VarChar(30)
  /// 운송사
  carrierCompany String? @map("carrier_company") @db.VarChar(100)
  /// 차량 번호
  vehicleNo      String? @map("vehicle_no") @db.VarChar(30)
  /// 배송 추적 URL
  trackingUrl    String? @map("tracking_url") @db.Text

  /// 팔레트 수량
  palletCount         Int?    @map("pallet_count")
  /// 팔레트 유형
  palletType          String? @map("pallet_type") @db.VarChar(20)
  /// 컨테이너 번호
  containerNo         String? @map("container_no") @db.VarChar(30)
  /// 컨테이너 유형
  containerType       String? @map("container_type") @db.VarChar(20)
  /// 총 중량 (kg)
  totalWeightKg       Float?  @map("total_weight_kg")
  /// 총 부피 (CBM)
  totalVolumeCbm      Float?  @map("total_volume_cbm")
  /// 특수 지시사항
  specialInstructions String? @map("special_instructions") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  items    OutboundItem[]
  calendar DeliveryCalendar[]
  driver   DeliveryDriver?    @relation(fields: [driverId], references: [id])

  @@index([siteId, status])
  @@index([siteId, scheduledDate])
  @@index([manifestNumber])
  @@index([customerId])
  @@index([driverId])
  @@map("outbound_orders")
}

/// 출고 품목 명세
model OutboundItem {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  outboundOrderId String    @map("outbound_order_id") @db.Uuid
  /// 상품 SKU
  sku             String    @map("sku_code") @db.VarChar(100)
  /// 상품명
  itemName        String?   @map("item_name") @db.VarChar(200)
  /// 수량
  qty             Int
  /// 단가 (원)
  unitPrice       Int       @default(0) @map("unit_price")
  /// 피킹 담당자
  pickedBy        String?   @map("picked_by") @db.VarChar(100)
  /// 피킹 시각
  pickedAt        DateTime? @map("picked_at") @db.Timestamptz
  /// 출고 위치 (spatial_objects 참조)
  spatialObjectId String?   @map("spatial_object_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  outboundOrder OutboundOrder @relation(fields: [outboundOrderId], references: [id], onDelete: Cascade)

  @@index([outboundOrderId])
  @@index([sku])
  @@map("outbound_items")
}

/// 입출고 달력
model DeliveryCalendar {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId          String   @map("site_id") @db.Uuid
  /// 유형: INBOUND | OUTBOUND
  type            String   @db.VarChar(10)
  /// 입고 주문 ID (INBOUND 시)
  inboundOrderId  String?  @map("inbound_order_id") @db.Uuid
  /// 출고 주문 ID (OUTBOUND 시)
  outboundOrderId String?  @map("outbound_order_id") @db.Uuid
  /// 예정일
  scheduledDate   DateTime @map("scheduled_date") @db.Date
  /// 타임슬롯 (AM / PM / NIGHT / CUSTOM)
  timeSlot        String?  @map("time_slot") @db.VarChar(20)
  /// 상태
  status          String   @default("SCHEDULED") @db.VarChar(20)
  /// 색상 코드
  colorCode       String?  @map("color_code") @db.VarChar(7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site          Site           @relation(fields: [siteId], references: [id])
  inboundOrder  InboundOrder?  @relation(fields: [inboundOrderId], references: [id], onDelete: Cascade)
  outboundOrder OutboundOrder? @relation(fields: [outboundOrderId], references: [id], onDelete: Cascade)

  @@index([siteId, scheduledDate])
  @@index([siteId, type])
  @@map("delivery_calendar")
}

// ============================================================
// B2C 대량 출고 업로드 로그
// ============================================================

/// B2C 대량 출고 CSV/Excel 업로드 이력
model BulkUploadLog {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId        String  @map("site_id") @db.Uuid
  /// 업로드 파일명
  fileName      String  @map("file_name") @db.VarChar(500)
  /// 파일 크기 (bytes)
  fileSize      Int     @map("file_size")
  /// 총 행 수
  totalRows     Int     @map("total_rows")
  /// 성공 건수
  successCount  Int     @default(0) @map("success_count")
  /// 오류 건수
  errorCount    Int     @default(0) @map("error_count")
  /// 경고 건수
  warningCount  Int     @default(0) @map("warning_count")
  /// 업로드 상태: PARSING → VALIDATED → CREATING → COMPLETED → FAILED
  status        String  @default("PARSING") @db.VarChar(20)
  /// 플랫폼 유형: COUPANG | SMARTSTORE | CUSTOM
  platformType  String  @default("CUSTOM") @map("platform_type") @db.VarChar(30)
  /// 컬럼 매핑 설정 (JSON)
  columnMapping Json?   @map("column_mapping")
  /// 오류 상세 (JSON)
  errorDetails  Json?   @map("error_details")
  /// 업로드자 ID
  uploadedBy    String? @map("uploaded_by") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id])

  @@index([siteId, createdAt])
  @@index([status])
  @@map("bulk_upload_logs")
}

// ============================================================
// 수주 관리 + MRP 소요 분석 + 재고 더블체크
// ============================================================

/// 수주 (고객 발주 수신)
model SalesOrder {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId           String    @map("site_id") @db.Uuid
  /// 수주 번호 (AUTO: SO-YYYYMMDD-XXXX)
  orderNo          String    @unique @map("order_no") @db.VarChar(30)
  /// 고객사 ID (erp_customers 참조)
  customerId       String?   @map("customer_id") @db.Uuid
  /// 고객사명 (비정규화)
  customerName     String?   @map("customer_name") @db.VarChar(200)
  /// 상태: RECEIVED → MRP_CHECKED → CONFIRMED → IN_PRODUCTION → SHIPPED
  status           String    @default("RECEIVED") @db.VarChar(20)
  /// 수주일
  orderDate        DateTime  @default(now()) @map("order_date") @db.Date
  /// 납기일
  deliveryDeadline DateTime? @map("delivery_deadline") @db.Date
  /// 품목 목록 [{product_sku, qty, unit_price}]
  items            Json      @default("[]")
  /// 비고
  notes            String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  mrpResults            MrpResult[]
  stockChecks           StockCheckRequest[]
  productionSuggestions ProductionPlanSuggestion[]

  @@index([siteId, status])
  @@index([siteId, deliveryDeadline])
  @@index([customerId])
  @@map("sales_orders")
}

/// BOM — Bill of Materials (제품별 소요 자재 목록)
model BomItem {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId       String  @map("site_id") @db.Uuid
  /// 완성품 SKU
  productSku   String  @map("product_sku") @db.VarChar(100)
  /// 소요 자재 SKU
  materialSku  String  @map("material_sku") @db.VarChar(100)
  /// 완성품 1개당 필요 자재 수량
  qtyPerUnit   Float   @map("qty_per_unit")
  /// 단위 (개, kg, L 등)
  unit         String  @default("개") @db.VarChar(20)
  /// 자재 조달 소요일
  leadTimeDays Int     @default(0) @map("lead_time_days")
  /// 비고
  notes        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([siteId, productSku, materialSku])
  @@index([productSku])
  @@index([materialSku])
  @@map("bom_items")
}

/// MRP 소요량 계산 결과
model MrpResult {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  salesOrderId     String    @map("sales_order_id") @db.Uuid
  /// 소요 자재 SKU
  materialSku      String    @map("material_sku") @db.VarChar(100)
  /// 자재명
  materialName     String?   @map("material_name") @db.VarChar(200)
  /// 필요 수량
  requiredQty      Float     @map("required_qty")
  /// 현재 재고
  currentStock     Float     @map("current_stock")
  /// 부족 수량 (required - current, 음수이면 0)
  shortageQty      Float     @map("shortage_qty")
  /// 자동 발주 생성 여부
  reorderTriggered Boolean   @default(false) @map("reorder_triggered")
  /// 더블체크 담당자
  checkedBy        String?   @map("checked_by") @db.VarChar(200)
  /// 더블체크 시각
  checkedAt        DateTime? @map("checked_at") @db.Timestamptz
  /// 상태: PENDING → CHECKED_OK → CHECKED_SHORTAGE → REORDERED
  status           String    @default("PENDING") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  salesOrder  SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  stockChecks StockCheckRequest[]

  @@index([salesOrderId])
  @@index([materialSku])
  @@index([status])
  @@map("mrp_results")
}

/// 재고 더블체크 요청
model StockCheckRequest {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  mrpResultId  String    @map("mrp_result_id") @db.Uuid
  salesOrderId String    @map("sales_order_id") @db.Uuid
  /// 재고 담당자 user_id
  assignedTo   String?   @map("assigned_to") @db.VarChar(200)
  /// 요청 시각
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  /// 응답 시각
  respondedAt  DateTime? @map("responded_at") @db.Timestamptz
  /// 담당자가 확인한 실물 수량
  actualQty    Float?    @map("actual_qty")
  /// 시스템 재고 vs 실물 차이
  discrepancy  Float?
  /// 상태: PENDING → IN_PROGRESS → CONFIRMED → DISCREPANCY_FOUND
  status       String    @default("PENDING") @db.VarChar(20)
  /// 비고
  notes        String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  mrpResult  MrpResult  @relation(fields: [mrpResultId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([mrpResultId])
  @@index([assignedTo, status])
  @@map("stock_check_requests")
}

// ============================================================
// 거래처 확장 — 연락처 / 계좌 / 첨부파일 / 거래 요약
