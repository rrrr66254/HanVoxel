  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_bank_accounts")
}

/// 거래처 첨부파일 (사업자등록증, 통장사본, 계약서 등)
model PartnerAttachment {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 거래처 ID
  partnerId  String   @map("partner_id") @db.Uuid
  /// 파일 유형 (사업자등록증/통장사본/계약서/기타)
  fileType   String   @map("file_type") @db.VarChar(30)
  /// 파일명
  fileName   String   @map("file_name") @db.VarChar(500)
  /// 파일 URL
  fileUrl    String   @map("file_url") @db.Text
  /// 업로드 일시
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_attachments")
}

/// 거래처 월별 거래 요약
model PartnerTransactionSummary {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 거래처 ID
  partnerId         String    @map("partner_id") @db.Uuid
  /// 연도
  year              Int
  /// 월
  month             Int
  /// 총 매입액 (만원)
  totalPurchaseAmt  Int       @default(0) @map("total_purchase_amt")
  /// 총 매출액 (만원)
  totalSalesAmt     Int       @default(0) @map("total_sales_amt")
  /// 매입 건수
  purchaseCount     Int       @default(0) @map("purchase_count")
  /// 매출 건수
  salesCount        Int       @default(0) @map("sales_count")
  /// 평균 리드타임 (일)
  avgLeadTime       Float?    @map("avg_lead_time")
  /// 납기 준수율 (%)
  onTimeRate        Float?    @map("on_time_rate")
  /// 반품 건수
  returnCount       Int       @default(0) @map("return_count")
  /// 최근 거래 일시
  lastTransactionAt DateTime? @map("last_transaction_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, year, month])
  @@index([partnerId])
  @@map("partner_transaction_summaries")
}

// ============================================================
// 배송 기사 관리
// ============================================================

/// 배송 기사
model DeliveryDriver {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 사이트 ID
  siteId         String   @map("site_id") @db.Uuid
  /// 기사명
  name           String   @db.VarChar(100)
  /// 연락처
  phone          String   @db.VarChar(30)
  /// 운송사
  carrierCompany String?  @map("carrier_company") @db.VarChar(100)
  /// 차량 번호
  vehicleNo      String?  @map("vehicle_no") @db.VarChar(30)
  /// 차량 종류
  vehicleType    String?  @map("vehicle_type") @db.VarChar(30)
  /// 전담 기사 여부
  isRegular      Boolean  @default(false) @map("is_regular")
  /// 메모
  memo           String?  @db.Text
  /// 활성 상태
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  inboundOrders  InboundOrder[]
  outboundOrders OutboundOrder[]

  @@index([siteId])
  @@map("delivery_drivers")
}

// ============================================================
// Production / MES — 생산 관리 (Phase 4)
// ============================================================

/// 작업장/공정
model WorkCenter {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId          String  @map("site_id") @db.Uuid
  /// 작업장 코드 (WC-001)
  code            String  @db.VarChar(30)
  /// 작업장명
  name            String  @db.VarChar(200)
  /// 타입: MACHINE | MANUAL | ASSEMBLY | QC
  type            String  @db.VarChar(20)
  /// 일 생산 가능 수량
  capacityPerDay  Int     @default(0) @map("capacity_per_day")
  /// 상태: RUNNING | IDLE | MAINTENANCE | BREAKDOWN
  status          String  @default("IDLE") @db.VarChar(20)
  /// 창고 내 위치 (spatial_objects 참조)
  spatialObjectId String? @map("spatial_object_id") @db.Uuid
  /// 담당자
  responsibleUser String? @map("responsible_user") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  productionOrders ProductionOrder[]
  processes        ProductionProcess[]
  maintenances     EquipmentMaintenance[]
  kpis             ProductionKpi[]
  planSuggestions  ProductionPlanSuggestion[]

  @@unique([siteId, code])
  @@index([siteId, status])
  @@map("work_centers")
}

/// 생산 지시서
model ProductionOrder {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId          String    @map("site_id") @db.Uuid
  /// 지시서 번호 (AUTO: WO-YYYYMMDD-XXXX)
  orderNo         String    @unique @map("order_no") @db.VarChar(30)
  /// 수주 연동 (nullable — 자체 생산 가능)
  salesOrderId    String?   @map("sales_order_id") @db.Uuid
  /// 완성품 SKU
  productSku      String    @map("product_sku") @db.VarChar(100)
  /// 완성품명 (비정규화)
  productName     String?   @map("product_name") @db.VarChar(200)
  /// 계획 수량
  plannedQty      Int       @map("planned_qty")
  /// 실제 생산 수량
  actualQty       Int       @default(0) @map("actual_qty")
  /// 불량 수량
  defectQty       Int       @default(0) @map("defect_qty")
  /// 상태: PLANNED → RELEASED → IN_PROGRESS → PAUSED → COMPLETED → CANCELLED
  status          String    @default("PLANNED") @db.VarChar(20)
  /// 우선순위: URGENT | HIGH | NORMAL | LOW
  priority        String    @default("NORMAL") @db.VarChar(10)
  /// 계획 시작일시
  plannedStartAt  DateTime? @map("planned_start_at") @db.Timestamptz
  /// 계획 종료일시
  plannedEndAt    DateTime? @map("planned_end_at") @db.Timestamptz
  /// 실제 시작일시
  actualStartAt   DateTime? @map("actual_start_at") @db.Timestamptz
  /// 실제 종료일시
  actualEndAt     DateTime? @map("actual_end_at") @db.Timestamptz
  /// 담당 작업장
  workCenterId    String?   @map("work_center_id") @db.Uuid
  /// 작업자 목록 (JSON 배열)
  assignedWorkers Json      @default("[]") @map("assigned_workers")
  /// 비고
  notes           String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workCenter      WorkCenter?                @relation(fields: [workCenterId], references: [id])
  processes       ProductionProcess[]
  logs            ProductionLog[]
  materials       ProductionMaterial[]
  planSuggestions ProductionPlanSuggestion[]

  @@index([siteId, status])
  @@index([siteId, plannedStartAt])
  @@index([workCenterId])
  @@index([salesOrderId])
  @@map("production_orders")
}

/// 공정 단계 (생산 지시서별)
model ProductionProcess {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productionOrderId String    @map("production_order_id") @db.Uuid
  /// 공정 순서 (1, 2, 3...)
  stepNo            Int       @map("step_no")
  /// 공정명 (프레스 성형 / 용접 / 도장 / 조립 / 검사)
  processName       String    @map("process_name") @db.VarChar(200)
  /// 작업장
  workCenterId      String?   @map("work_center_id") @db.Uuid
  /// 계획 소요 시간 (분)
  plannedDuration   Int?      @map("planned_duration")
  /// 실제 소요 시간 (분)
  actualDuration    Int?      @map("actual_duration")
  /// 상태: PENDING → IN_PROGRESS → DONE → SKIPPED
  status            String    @default("PENDING") @db.VarChar(20)
  /// 담당 작업자
  workerId          String?   @map("worker_id") @db.VarChar(200)
  /// 시작 시각
  startedAt         DateTime? @map("started_at") @db.Timestamptz
  /// 종료 시각
  endedAt           DateTime? @map("ended_at") @db.Timestamptz
  /// 비고
  notes             String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenter      WorkCenter?     @relation(fields: [workCenterId], references: [id])
  logs            ProductionLog[]

  @@index([productionOrderId, stepNo])
  @@map("production_processes")
}

/// 생산 실적 기록 (실시간)
model ProductionLog {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productionOrderId String   @map("production_order_id") @db.Uuid
  /// 공정 ID (nullable — 전체 WO 레벨 로그도 가능)
  processId         String?  @map("process_id") @db.Uuid
  /// 로그 타입: START | PROGRESS | PAUSE | RESUME | COMPLETE | DEFECT | NOTE
  logType           String   @map("log_type") @db.VarChar(20)
  /// 이 로그 시점까지 생산량
  qtyProduced       Int?     @map("qty_produced")
  /// 이 로그 시점 불량 수량
  qtyDefect         Int?     @map("qty_defect")
  /// 불량 원인 코드
  defectReason      String?  @map("defect_reason") @db.VarChar(50)
  /// 작업자
  workerId          String?  @map("worker_id") @db.VarChar(200)
  /// 기록 시각
  loggedAt          DateTime @default(now()) @map("logged_at") @db.Timestamptz
  /// 비고
  notes             String?  @db.Text

  productionOrder ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  process         ProductionProcess? @relation(fields: [processId], references: [id])

  @@index([productionOrderId, loggedAt])
  @@index([logType])
  @@map("production_logs")
}

/// 생산 자재 불출
model ProductionMaterial {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productionOrderId String    @map("production_order_id") @db.Uuid
  /// 자재 SKU
  materialSku       String    @map("material_sku") @db.VarChar(100)
  /// 자재명 (비정규화)
  materialName      String?   @map("material_name") @db.VarChar(200)
  /// BOM 기준 필요량
  plannedQty        Float     @map("planned_qty")
  /// 실제 불출량
  issuedQty         Float     @default(0) @map("issued_qty")
  /// 반납량 (잉여)
  returnedQty       Float     @default(0) @map("returned_qty")
  /// 불출 시각
  issuedAt          DateTime? @map("issued_at") @db.Timestamptz
  /// 불출 담당자
  issuedBy          String?   @map("issued_by") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@index([materialSku])
  @@map("production_materials")
}

/// 불량 코드 마스터
model DefectCode {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId   String @map("site_id") @db.Uuid
  /// 불량 코드 (DIM, SUR, WEL, ASM, MAT, ETC)
  code     String @db.VarChar(20)
  /// 불량명
  name     String @db.VarChar(100)
  /// 카테고리 (치수불량 / 표면결함 / 용접불량 / 조립오류 / 재료불량 / 기타)
  category String @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([siteId, code])
  @@map("defect_codes")
}

/// 설비 유지보수
model EquipmentMaintenance {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workCenterId    String    @map("work_center_id") @db.Uuid
  /// 유형: SCHEDULED | BREAKDOWN | PREVENTIVE
  type            String    @db.VarChar(20)
  /// 상태: PENDING → IN_PROGRESS → COMPLETED
  status          String    @default("PENDING") @db.VarChar(20)
  /// 예정일
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamptz
  /// 완료일
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  /// 가동 중단 시간 (분)
  downtimeMinutes Int       @default(0) @map("downtime_minutes")
  /// 수리 기사
  technician      String?   @db.VarChar(200)
  /// 비용
  cost            Float?
  /// 비고
  notes           String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workCenter WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@index([workCenterId, status])
  @@index([scheduledAt])
  @@map("equipment_maintenances")
}

/// 생산 KPI 일별 집계
model ProductionKpi {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 집계 날짜
  date            DateTime @db.Date
  /// 작업장
  workCenterId    String   @map("work_center_id") @db.Uuid
  /// 계획 수량
  plannedQty      Int      @default(0) @map("planned_qty")
  /// 실제 생산 수량
  actualQty       Int      @default(0) @map("actual_qty")
  /// 불량 수량
  defectQty       Int      @default(0) @map("defect_qty")
  /// 달성률 (%)
  achievementRate Float    @default(0) @map("achievement_rate")
  /// 불량률 (%)
  defectRate      Float    @default(0) @map("defect_rate")
  /// OEE (가동률 × 성능률 × 품질률)
  oeeScore        Float    @default(0) @map("oee_score")
  /// 가동 중단 시간 (분)
  downtimeMinutes Int      @default(0) @map("downtime_minutes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  workCenter WorkCenter @relation(fields: [workCenterId], references: [id])

  @@unique([date, workCenterId])
  @@index([workCenterId, date])
  @@map("production_kpis")
}

// ── 생산 계획 추천 (수주 → 생산 자동 연동) ──────────────
/// 확정된 수주(Sales Order)로부터 생산 계획을 자동 추천
model ProductionPlanSuggestion {
  id                      String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 사이트
  siteId                  String    @map("site_id") @db.Uuid
  /// 수주 ID
  salesOrderId            String    @map("sales_order_id") @db.Uuid
  /// 수주 번호
  salesOrderNo            String    @map("sales_order_no") @db.VarChar(50)
  /// 제품 SKU
  productSku              String    @map("product_sku") @db.VarChar(100)
  /// 제품명
  productName             String?   @map("product_name") @db.VarChar(200)
  /// 필요 수량
  requiredQty             Int       @map("required_qty")
  /// 납기 기한
  deliveryDeadline        DateTime? @map("delivery_deadline") @db.Timestamptz
  /// AI 추천 생산 시작일
  recommendedStartAt      DateTime? @map("recommended_start_at") @db.Timestamptz
  /// AI 추천 생산 종료일
  recommendedEndAt        DateTime? @map("recommended_end_at") @db.Timestamptz
  /// 추천 작업장 ID
  recommendedWorkCenterId String?   @map("recommended_work_center_id") @db.Uuid
  /// 긴급도 (CRITICAL | HIGH | NORMAL)
  urgencyLevel            String    @default("NORMAL") @map("urgency_level") @db.VarChar(20)
  /// 실행 가능성 (FEASIBLE | MATERIAL_SHORT | CAPACITY_FULL)
  feasibility             String    @default("FEASIBLE") @db.VarChar(20)
  /// 추천 사유
  reason                  String?   @db.Text
  /// 상태 (PENDING | ACCEPTED | REJECTED | SCHEDULED)
  status                  String    @default("PENDING") @db.VarChar(20)
  /// 수락 후 생성된 생산 지시서 ID
  productionOrderId       String?   @map("production_order_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site            Site             @relation(fields: [siteId], references: [id])
  salesOrder      SalesOrder       @relation(fields: [salesOrderId], references: [id])
  workCenter      WorkCenter?      @relation(fields: [recommendedWorkCenterId], references: [id])
  /// 수락 후 연결된 생산 지시서
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  @@index([siteId, status])
  @@index([salesOrderId])
  @@map("production_plan_suggestions")
}
