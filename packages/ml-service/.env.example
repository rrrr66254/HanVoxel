# ============================================
# HanVoxel ML Service — 환경 변수 설정
# ============================================
# 이 파일을 복사하여 .env 파일을 만드세요:
#   cp .env.example .env

# ── 서버 ──
ML_SERVICE_PORT=8000
LOG_LEVEL=INFO

# ── 데이터베이스 (PostgreSQL) ──
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hanvoxel

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── API Gateway 연결 ──
API_GATEWAY_URL=http://localhost:3001

# ── 무역 데이터 API 키 (Phase 3) ──
COMTRADE_API_KEY=
KR_CUSTOMS_API_KEY=
US_CENSUS_API_KEY=
