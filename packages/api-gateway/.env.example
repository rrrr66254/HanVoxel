# ============================================
# HanVoxel API Gateway — 환경 변수 설정
# ============================================
# 이 파일을 복사하여 .env 파일을 만드세요:
#   cp .env.example .env

# ── 서버 ──
PORT=3001

# ── 데이터베이스 (PostgreSQL) ──
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hanvoxel

# ── ML Service 연결 ──
ML_SERVICE_URL=http://localhost:8000

# ── 프론트엔드 URL (Stripe 리다이렉트 등) ──
FRONTEND_URL=http://localhost:5173

# ── Stripe 결제 ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ERP 커넥터 (선택) ──
DOUZON_API_URL=
YOUNGLIMWON_API_URL=
